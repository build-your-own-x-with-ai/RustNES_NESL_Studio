// MAZE RUN — the 003 game API in one screen:
// a text map for walls, a 16x16 metasprite hero, collide(), sfx(), and print() anywhere.
// Collect every coin ($) while avoiding the ghost. START restarts.

const PAL: [u8] = [
    0x0F, 0x12, 0x22, 0x30,  0x0F, 0x28, 0x38, 0x30,  0x0F, 0x30, 0x10, 0x00,  0x0F, 0x30, 0x10, 0x00,
    0x0F, 0x27, 0x37, 0x30,  0x0F, 0x14, 0x24, 0x34,  0x0F, 0x30, 0x10, 0x00,  0x0F, 0x30, 0x10, 0x00,
];

map LEVEL = [
    "................................",
    "................................",
    "................................",
    "################################",
    "#$.............#..............$#",
    "#..####..####..#..####..####...#",
    "#..#.......$#.....#$.......#...#",
    "#..#..####..#..#..#..####..#...#",
    "#.....#..#.....#.....#..#......#",
    "#..$..#..#..#######..#..#..$...#",
    "#.....####.............####....#",
    "####.........#######.........###",
    "#......$.....#.....#.....$.....#",
    "#..#######...#.....#...#######.#",
    "#............#.....#...........#",
    "#..$.........###.###........$..#",
    "#..####..#.............#..####.#",
    "#.....#..#..#########..#..#....#",
    "#..$..#.....#.......#.....#.$..#",
    "#.....#######...$...#######....#",
    "#..............................#",
    "#..####..####..#..####..####...#",
    "#$.............#..............$#",
    "################################",
];

tile '#' = ["33333333", "31111113", "31222213", "31222213", "31222213", "31222213", "31111113", "33333333"];
tile '$' = ["........", "..3333..", ".322223.", ".321123.", ".321123.", ".322223.", "..3333..", "........"];

// 16x16 hero from four 8x8 tiles (1-4); the ghost is a single tile (5)
tile 1 = ["....3333", "..333333", ".3311333", ".3311333", "33333333", "33333333", "33333333", "33333332"];
tile 2 = ["3333....", "333333..", "3311333.", "3311333.", "33333333", "33333333", "33333333", "23333333"];
tile 3 = ["33333322", "33333222", "33332222", ".3333222", ".3333322", "..333333", "...333..", "...33..."];
tile 4 = ["22333333", "22233333", "22223333", "2223333.", "2233333.", "333333..", "..333...", "...33..."];
tile 5 = ["..3333..", ".333333.", "31133113", "31133113", "33333333", "33333333", "33333333", "3.33.3.3"];

metasprite HERO = [(0, 0, 1), (8, 0, 2), (0, 8, 3), (8, 8, 4)];

struct Mob { x: u8, y: u8, vx: i8, vy: i8 }

var hero: Mob;
var ghost: Mob;
var coins: [u8; 32];     // coin (x, y) tiles, collected = 0xFF
var ncoins: u8;
var left: u8;
var score: u8;
var lives: u8;
var hurt: u8;            // invulnerability frames

// Is the 16x16 box at (x, y) free of walls? Checks the four corners.
fn free(x: u8, y: u8) -> u8 {
    if map_tile(LEVEL, x >> 3, y >> 3) == '#' { return 0; }
    if map_tile(LEVEL, (x + 15) >> 3, y >> 3) == '#' { return 0; }
    if map_tile(LEVEL, x >> 3, (y + 15) >> 3) == '#' { return 0; }
    if map_tile(LEVEL, (x + 15) >> 3, (y + 15) >> 3) == '#' { return 0; }
    return 1;
}

fn reset_level() {
    draw_map(LEVEL);
    ncoins = 0;
    for ty in 0..30 {
        for tx in 0..32 {
            if map_tile(LEVEL, tx, ty) == '$' && ncoins < 16 {
                coins[ncoins * 2] = tx;
                coins[ncoins * 2 + 1] = ty;
                ncoins += 1;
            }
        }
    }
    left = ncoins;
    score = 0;
    lives = 3;
    hero.x = 8; hero.y = 40;
    ghost.x = 232; ghost.y = 168; ghost.vx = -1; ghost.vy = 1;
    print(1, 1, "MAZE RUN   COINS    LIVES");
}

fn move_ghost() {
    if free(ghost.x + ghost.vx, ghost.y) { ghost.x += ghost.vx; } else { ghost.vx = -ghost.vx; sfx(SFX_HIT); }
    if free(ghost.x, ghost.y + ghost.vy) { ghost.y += ghost.vy; } else { ghost.vy = -ghost.vy; }
    // drift toward the hero now and then
    if frame_count() & 63 == 0 {
        match rand() & 3 {
            0 => ghost.vx = 1,
            1 => ghost.vx = -1,
            2 => ghost.vy = 1,
            _ => ghost.vy = -1,
        }
    }
}

fn main() {
    load_palette(PAL);
    reset_level();
    ppu_on();

    loop {
        wait_vblank();
        let pad = joypad(0);

        if lives == 0 || left == 0 {
            if left == 0 { print(11, 14, "YOU WIN!"); } else { print(10, 14, "GAME OVER"); }
            if pad & BTN_START { reset_level(); }
            continue;
        }

        // hero movement with wall sliding
        hero.vx = 0; hero.vy = 0;
        if pad & BTN_LEFT { hero.vx = -2; }
        if pad & BTN_RIGHT { hero.vx = 2; }
        if pad & BTN_UP { hero.vy = -2; }
        if pad & BTN_DOWN { hero.vy = 2; }
        if hero.vx != 0 && free(hero.x + hero.vx, hero.y) { hero.x += hero.vx; }
        if hero.vy != 0 && free(hero.x, hero.y + hero.vy) { hero.y += hero.vy; }

        // coins: erase the tile and update the HUD — print() is safe at any time now
        for i in 0..ncoins {
            let cx = coins[i * 2];
            if cx != 0xFF && collide(hero.x, hero.y, 16, 16, cx << 3, coins[i * 2 + 1] << 3, 8, 8) {
                set_tile(cx, coins[i * 2 + 1], ' ');
                coins[i * 2] = 0xFF;
                score += 1;
                left -= 1;
                sfx(SFX_COIN);
            }
        }

        move_ghost();
        if hurt > 0 { hurt -= 1; }
        if hurt == 0 && collide(hero.x + 2, hero.y + 2, 12, 12, ghost.x, ghost.y, 8, 8) {
            lives -= 1;
            hurt = 90;
            sfx(SFX_EXPLODE);
        }

        print_u8(17, 1, score);
        print_u8(28, 1, lives);
        let next = metasprite(0, hero.x, hero.y, HERO);
        if hurt & 4 { metasprite(0, 0, 0xF0, HERO); }   // blink while invulnerable
        sprite(next, ghost.x, ghost.y, 5, 1);
    }
}

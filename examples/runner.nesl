// RUNNER — a four-screen side-scroller (NESL 004: wide maps, camera, palette zones).
// LEFT/RIGHT to run, A to jump. Grab the coins, reach the flag at the far right.

const PAL: [u8] = [
    0x21, 0x30, 0x10, 0x0F,  0x21, 0x29, 0x19, 0x0F,  0x21, 0x27, 0x17, 0x0F,  0x21, 0x28, 0x18, 0x0F,
    0x21, 0x16, 0x27, 0x18,  0x21, 0x28, 0x38, 0x0F,  0x21, 0x30, 0x10, 0x0F,  0x21, 0x0F, 0x30, 0x16,
];

// Three-voice background music: melody (pulse 1), bass (triangle), harmony (pulse 2).
// All voices are 4 bars long so they loop together. Jump/coin effects borrow the harmony.
music THEME = ["T150 O4 L8 C E G >C< G E C R | D F A >D< A F D R",
               "E G B >E< B G E R | F A >C F< E D C4"];
music BASS  = "T150 O2 L4 C G C G | D A D A | E B E B | F >C< G <G>";
music HARM  = "T150 V6 @1 O4 L2 E G | F A | G B | A G";

const GRAVITY = 1;
const JUMP = -7;
const FLOOR_LIMIT = 216;

map WORLD = [
    "................................................................................................................................",
    "................................................................................................................................",
    "................................................................................................................................",
    "................................................................................................................................",
    "................................................................................................................................",
    "...........................................................................................................................|....",
    "...........................................................................................................................|....",
    "............$$$................................$$$$.......................................$$$..............................|....",
    "...........=====...............................======...............................=========..............................|....",
    "...........................................................................................................................|....",
    "..............................$$..................................$$$......................................................|....",
    "............................======...............................=====.......................................$$............|....",
    ".....................................................................................=====.................=======.........|....",
    "...........................................................................................................................|....",
    "..................$$$...................................$$.......................................$$$.......................|....",
    ".................======..........$..................=======....................................=======.....................|....",
    "...............................=====...............................................................................=====...|....",
    "...........................................................................................................................|....",
    "......#........................................................................#...........................................|....",
    ".....###..........................................$$...........................##..........................................|....",
    "....#####.......................................#####..........................###.........................................|.#..",
    "################################.......#########################......##################...........#############################",
    "################################.......#########################......##################...........#############################",
    "################################.......#########################......##################...........#############################",
    "################################################################################################################################",
    "################################################################################################################################",
    "################################################################################################################################",
    "################################################################################################################################",
    "################################################################################################################################",
    "################################################################################################################################",
];

// sky / clouds use palette 0, platforms 1, ground 2
palette_zone WORLD = [
    "................................................................",
    "................................................................",
    "................................................................",
    "................................................................",
    "1111111111111111111111111111111111111111111111111111111111111111",
    "1111111111111111111111111111111111111111111111111111111111111111",
    "1111111111111111111111111111111111111111111111111111111111111111",
    "1111111111111111111111111111111111111111111111111111111111111111",
    "1111111111111111111111111111111111111111111111111111111111111111",
    "1111111111111111111111111111111111111111111111111111111111111111",
    "2222222222222222222222222222222222222222222222222222222222222222",
    "2222222222222222222222222222222222222222222222222222222222222222",
    "2222222222222222222222222222222222222222222222222222222222222222",
    "2222222222222222222222222222222222222222222222222222222222222222",
    "2222222222222222222222222222222222222222222222222222222222222222",
];

tile '#' = ["33333333", "12222221", "12222221", "12222221", "33333333", "22212222", "22212222", "22212222"];
tile '=' = ["33333333", "31111113", "31111113", "33333333", "........", "........", "........", "........"];
tile '$' = ["..3333..", ".311113.", "31122113", "31122113", "31122113", "31122113", ".311113.", "..3333.."];
tile '|' = ["...11...", "...3333.", "...33333", "...3333.", "...3....", "...3....", "...3....", "...3...."];

// 16 pixels tall from hat to boots, so the physics box (16 px) matches what is drawn
tile 1 = ["...3333.", "..333333", "..311.1.", "..31111.", "...1111.", "..2222..", ".222222.", ".2.22.2."];
tile 2 = [".2.22.2.", "..2222..", "..2..2..", "..2..2..", "..2..2..", ".33..33.", ".33..33.", "33...33."];
metasprite HERO = [(0, 0, 1), (0, 8, 2)];

struct Body { x: u16, y: u8, vy: i8, ground: u8 }

var hero: Body;
var score: u8;
var won: u8;
var prev_pad: u8;
var cam: u16;      // camera position, kept for tests and debugging

fn solid(x: u16, y: u8) -> u8 {
    let t = map_tile(WORLD, x >> 3, y >> 3);
    return t == '#' || t == '=';
}

fn main() {
    load_palette(PAL);
    draw_map(WORLD);
    status_bar(3);                       // the top 3 rows stay put while the level scrolls
    print(2, 1, "COINS");
    hero.x = 24; hero.y = 120;
    ppu_on();
    play_music(THEME, BASS, HARM);

    loop {
        wait_vblank();
        let pad = joypad(0);

        if !won {
            // run: blocked by solid tiles at the side we move toward
            if pad & BTN_RIGHT && hero.x < 1008 && !solid(hero.x + 8, hero.y) && !solid(hero.x + 8, hero.y + 12) { hero.x += 2; }
            if pad & BTN_LEFT && hero.x > 2 && !solid(hero.x - 1, hero.y) && !solid(hero.x - 1, hero.y + 12) { hero.x -= 2; }

            // jump on press (not hold) while standing
            if pad & BTN_A && !(prev_pad & BTN_A) && hero.ground { hero.vy = JUMP; hero.ground = 0; sfx(SFX_JUMP); }

            // gravity, landing on top of solid tiles and bumping heads
            if hero.vy < 4 { hero.vy += GRAVITY; }
            let ny = hero.y + hero.vy;
            if hero.vy > 0 && (solid(hero.x + 1, ny + 15) || solid(hero.x + 6, ny + 15)) {
                hero.y = ((ny + 15) & 0xF8) - 16;
                hero.vy = 0;
                hero.ground = 1;
            } else if hero.vy < 0 && (solid(hero.x + 1, ny) || solid(hero.x + 6, ny)) {
                hero.vy = 0;
            } else {
                hero.y = ny;
                hero.ground = 0;
            }
            // falling into a pit: back to the start
            if hero.y > FLOOR_LIMIT { hero.x = 24; hero.y = 120; hero.vy = 0; sfx(SFX_HIT); }

            // coins: take the tile under the hero's middle
            let cx = (hero.x + 4) >> 3;
            let cy = (hero.y + 8) >> 3;
            if map_tile(WORLD, cx, cy) == '$' {
                // remembered in the map: the coin stays gone after scrolling away and back
                set_map_tile(WORLD, cx as u8, cy, ' ');
                score += 1;
                sfx(SFX_COIN);
            }
            if map_tile(WORLD, cx, cy) == '|' { won = 1; sfx(SFX_EXPLODE); print(20, 1, "YOU WIN!"); }
        }
        prev_pad = pad;

        camera_follow(hero.x, WORLD);

        // world -> screen coordinates
        cam = camera_x();
        let sx = hero.x - cam;
        metasprite(1, sx as u8, hero.y, HERO);   // sprite 0 belongs to the status bar
        print_u8(8, 1, score);
    }
}

// Hello, NES! — the smallest useful NESL program.
// Background palette 0: black background, white text.
const PAL: [u8] = [
    0x0F, 0x30, 0x16, 0x27,  0x0F, 0x30, 0x16, 0x27,  0x0F, 0x30, 0x16, 0x27,  0x0F, 0x30, 0x16, 0x27,
    0x0F, 0x30, 0x16, 0x27,  0x0F, 0x30, 0x16, 0x27,  0x0F, 0x30, 0x16, 0x27,  0x0F, 0x30, 0x16, 0x27,
];

fn main() {
    load_palette(PAL);
    print(11, 13, "HELLO NES!");
    print(6, 16, "WRITTEN IN NESL, NO ASM");
    ppu_on();
    loop {
        wait_vblank();
    }
}

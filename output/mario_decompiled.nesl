// ========== Main Entry Point ==========

fn main() {
    // ════════════════════════════════════════════════════════
    //   Super Mario Bros - Main Entry Point
    // ════════════════════════════════════════════════════════
    
    // Initialize PPU and load graphics
    init_ppu();
    
    // Show title screen
    show_title();
    
    // Wait for start button
    loop {
        let joy = joypad(0);
        if joy & 0x10 != 0 {  // Start button
            break;
        }
        wait_vblank();
    }
    
    // Game loop
    loop {
        // Call original NMI handler
        nmi();
        
        // Wait for next frame
        wait_vblank();
    }
}

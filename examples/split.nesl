// SPLIT: MMC3 scanline IRQ demo. The top 3 rows stay still; the field below scrolls.
const PAL: [u8] = [0x0F, 0x30, 0x16, 0x27, 0x0F, 0x21, 0x31, 0x11, 0x0F, 0x29, 0x19, 0x09, 0x0F, 0x26, 0x16, 0x06];
var cam: u16;

fn irq() {
    split_scroll(cam);      // from line 24 down, scroll by the camera
}

fn main() {
    load_palette(PAL);
    draw_map(FIELD);
    print(1, 1, "MMC3 SPLIT SCREEN");
    scroll(0, 0);           // the top part is never scrolled
    scanline_irq(24);
    ppu_on();
    loop {
        wait_vblank();
        cam = (cam + 1) & 511;
    }
}

map FIELD = [
    "                                                                ",
    "                                                                ",
    "                                                                ",

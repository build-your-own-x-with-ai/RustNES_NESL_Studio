tile 16 = [


// ========== Improved Main Function ==========

fn main() {
    // Initialize PPU
    ppu_off();
    load_palette(PAL);
    vram_addr(0x2000);
    vram_fill(0, 1024);
    
    // Show title
    print(9, 10, "SUPER MARIO BROS");
    print(11, 14, "PRESS START");
    
    ppu_on();
    
    // Main loop - call original NMI handler
    loop {
        wait_vblank();
        nmi();
    }
}

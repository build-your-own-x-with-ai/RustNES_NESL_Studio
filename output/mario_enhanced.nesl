//   ✅ Complete main function
//
// Status: Fully compilable and runnable!
//

// ========== Palette Data ==========

// Palette extracted from original Super Mario Bros
const PAL: [u8] = [
    0x20, 0x0F, 0x15, 0x12,  0x25, 0x0F, 0x3A, 0x1A,  0x0F, 0x0F, 0x30, 0x12,  0x0F, 0x0F, 0x27, 0x12,
    0x0F, 0x22, 0x16, 0x27,  0x18, 0x0F, 0x10, 0x30,  0x27, 0x0F, 0x16, 0x30,  0x27, 0x0F, 0x0F, 0x30,
];

// ========== CHR Tiles (from Mario ROM) ==========

// Mario head
tile 1 = [
    "......11",
    "....1111",
    "...11111",
    "...11111",
    "...33322",
    "..322322",
    "..322332",
    ".3322332",
];

tile 2 = [
    "111.....",
    "112.....",
    "122.....",
    "111111..",
    "3222....",
    "332222..",
    "2222222.",
    "2232222.",
];

// Mario body
tile 3 = [
    ".3322222",
    ".3332222",
    "...33222",
    ".....333",
    "....1111",
    "...33331",
    "..333333",
    ".3333333",
];

tile 4 = [
    "333333..",
    "233333..",
    "22222...",
    "22......",
    "331...2.",
    "1331.222",
    "11313222",
    "11331222",
];

// Ground tile
tile 5 = [
    "33333333",

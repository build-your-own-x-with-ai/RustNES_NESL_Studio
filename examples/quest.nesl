// COIN QUEST — six scrolling worlds, slimes to stomp, coins to collect.
// LEFT/RIGHT run, A jump, START begins. Reach the flag at the end of each world.

const PAL1: [u8] = [0x21, 0x30, 0x10, 0x0F,  0x21, 0x28, 0x18, 0x0F,  0x21, 0x27, 0x17, 0x0F,  0x21, 0x30, 0x10, 0x0F,
                    0x21, 0x16, 0x27, 0x18,  0x21, 0x2A, 0x1A, 0x0F,  0x21, 0x30, 0x10, 0x0F,  0x21, 0x0F, 0x30, 0x16];
const PAL2: [u8] = [0x31, 0x30, 0x10, 0x0F,  0x31, 0x2A, 0x1A, 0x0F,  0x31, 0x17, 0x07, 0x0F,  0x31, 0x30, 0x10, 0x0F,
                    0x31, 0x16, 0x27, 0x18,  0x31, 0x24, 0x14, 0x0F,  0x31, 0x30, 0x10, 0x0F,  0x31, 0x0F, 0x30, 0x16];
const PAL3: [u8] = [0x0C, 0x30, 0x10, 0x0F,  0x0C, 0x26, 0x16, 0x0F,  0x0C, 0x00, 0x2D, 0x0F,  0x0C, 0x30, 0x10, 0x0F,
                    0x0C, 0x16, 0x27, 0x18,  0x0C, 0x2B, 0x1B, 0x0F,  0x0C, 0x30, 0x10, 0x0F,  0x0C, 0x0F, 0x30, 0x16];

music THEME = ["T150 O4 L8 C E G >C< G E C R | D F A >D< A F D R",
               "E G B >E< B G E R | F A >C F< E D C4"];
music BASS  = "T150 O2 L4 C G C G | D A D A | E B E B | F >C< G <G>";
music HARM  = "T150 V6 @1 O4 L2 E G | F A | G B | A G";
music TUNE  = "T120 O4 L8 G >C E G4 E C< G | A >C F A4 F C< A";

tile '#' = ["33333333", "12222221", "12222221", "12222221", "33333333", "22212222", "22212222", "22212222"];
tile '=' = ["33333333", "31111113", "31111113", "33333333", "........", "........", "........", "........"];
tile '$' = ["..3333..", ".311113.", "31122113", "31122113", "31122113", "31122113", ".311113.", "..3333.."];
tile '|' = ["...11...", "...3333.", "...33333", "...3333.", "...3....", "...3....", "...3....", "...3...."];
tile 1 = ["...3333.", "..333333", "..311.1.", "..31111.", "...1111.", "..2222..", ".222222.", ".2.22.2."];
tile 2 = [".2.22.2.", "..2222..", "..2..2..", "..2..2..", "..2..2..", ".33..33.", ".33..33.", "33...33."];
tile 3 = ["........", "..2222..", ".222222.", "2212212.", "22222222", "22222222", "2.2.2.22", "........"];
metasprite HERO = [(0, 0, 1), (0, 8, 2)];

const WORLDS: [map] = [W1, W2, W3, W4, W5, W6];   // the maps are declared at the end of the file

const GROUND_Y = 168;
const START_X = 24;
const START_Y = 120;
const JUMP = -9;            // rises 36 px: one jump reaches the next platform tier
const FLAG_COL = 123;

// slimes: map columns per world, flattened (world w uses FOE_COL[FOE_FROM[w]..FOE_FROM[w + 1]])
const FOE_COL: [u8] = [20, 50, 72, 100,   15, 30, 45, 58, 82, 100,   12, 30, 52, 62, 75, 92, 110,
                       10, 28, 50, 72, 92, 114,   8, 26, 44, 62, 80, 98, 116,   8, 24, 40, 58, 76, 94, 110, 118];
const FOE_FROM: [u8] = [0, 4, 10, 17, 23, 30, 38];

struct Body { x: u16, y: u8, vy: i8, ground: u8 }
struct Foe { x: u16, y: u8, dir: i8, alive: u8 }

var hero: Body;
var foes: [Foe; 8];
var nfoes: u8;
var world: u8;
var state: u8;          // 0 title, 1 playing, 2 world clear, 3 game over, 4 won
var lives: u8;
var coins: u8;
var score: u16;
var hurt: u8;           // invulnerable frames after a hit
var timer: u8;
var prev: u8;
var cam: u16;

fn solid(x: u16, y: u8) -> u8 {
    let t = map_tile(WORLDS[world], x >> 3, y >> 3);
    return t == '#' || t == '=';
}

fn hide_all() {
    for i in 1..64 { hide_sprite(i); }
}

fn spawn() {
    hero.x = START_X; hero.y = START_Y; hero.vy = 0; hero.ground = 0;
    hurt = 90;          // a moment of safety after (re)spawning
    nfoes = 0;
    for k in FOE_FROM[world]..FOE_FROM[world + 1] {
        foes[nfoes].x = FOE_COL[k] << 3;
        foes[nfoes].y = GROUND_Y - 8;
        foes[nfoes].dir = -1;
        foes[nfoes].alive = 1;
        nfoes += 1;
    }
}

fn start_world() {
    hide_all();
    status_bar(3);
    match world % 3 {         // palettes cannot go in a list (yet); worlds 4-6 reuse them
        0 => load_palette(PAL1),
        1 => load_palette(PAL2),
        _ => load_palette(PAL3),
    }
    draw_map(WORLDS[world]);
    print(1, 1, "SCORE");
    print(13, 1, "COINS");
    print(23, 1, "L");
    print(27, 1, "W");
    set_tile(28, 1, '1' + world);
    spawn();
    play_music(THEME, BASS, HARM);
    state = 1;
}

fn show_screen(s: u8) {
    hide_all();
    stop_music();
    status_bar(0);
    load_palette(PAL1);
    match s {
        0 => draw_map(TITLE),
        3 => draw_map(OVER),
        _ => draw_map(WIN),
    }
    if s == 0 { play_music(TUNE); }
    state = s;
}

fn new_game() {
    lives = 3; coins = 0; score = 0;
    for w in 0..6 { reset_map(WORLDS[w]); }
    world = 0;
    start_world();
}

fn lose_life() {
    sfx(SFX_EXPLODE);
    lives -= 1;
    if lives == 0 { show_screen(3); } else { spawn(); }
}

fn update_hero(pad: u8, pressed: u8) {
    if pad & BTN_RIGHT && hero.x < (FLAG_COL << 3) + 8 && !solid(hero.x + 8, hero.y) && !solid(hero.x + 8, hero.y + 12) { hero.x += 2; }
    if pad & BTN_LEFT && hero.x > 2 && !solid(hero.x - 1, hero.y) && !solid(hero.x - 1, hero.y + 12) { hero.x -= 2; }
    if pressed & BTN_A && hero.ground { hero.vy = JUMP; hero.ground = 0; sfx(SFX_JUMP); }
    if hero.vy < 4 { hero.vy += 1; }
    let ny = hero.y + hero.vy;
    if hero.vy > 0 && (solid(hero.x + 1, ny + 15) || solid(hero.x + 6, ny + 15)) {
        hero.y = ((ny + 15) & 0xF8) - 16;
        hero.vy = 0;
        hero.ground = 1;
    } else if hero.vy < 0 && (solid(hero.x + 1, ny) || solid(hero.x + 6, ny)) {
        hero.vy = 0;
    } else {
        hero.y = ny;
        hero.ground = 0;
    }
    let cx = (hero.x + 4) >> 3;
    let cy = (hero.y + 8) >> 3;
    let t = map_tile(WORLDS[world], cx, cy);
    if t == '$' { set_map_tile(WORLDS[world], cx, cy, ' '); coins += 1; score += 10; sfx(SFX_COIN); }
    if t == '|' { stop_music(); sfx(SFX_COIN); timer = 90; state = 2; }
    if hero.y > 216 { lose_life(); }
}

fn update_foes() {
    let hx = hero.x - cam;
    for i in 0..nfoes {
        if !foes[i].alive { hide_sprite(3 + i); continue; }
        if frame_count() & 1 {
            let ahead = foes[i].x - 1;
            if foes[i].dir > 0 { ahead = foes[i].x + 8; }
            if solid(ahead, foes[i].y + 4) || !solid(ahead, foes[i].y + 8) {
                foes[i].dir = -foes[i].dir;
            } else {
                foes[i].x += foes[i].dir;
            }
        }
        let fx = foes[i].x - cam;
        if fx >= 248 { hide_sprite(3 + i); continue; }
        sprite(3 + i, fx as u8, foes[i].y, 3, 1);
        if collide(hx as u8, hero.y, 8, 16, fx as u8, foes[i].y, 8, 8) {
            if hero.vy > 0 && hero.y + 12 < foes[i].y {
                foes[i].alive = 0;
                hero.vy = -4;
                score += 50;
                sfx(SFX_HIT);
            } else if hurt == 0 {
                hurt = 60;
                lose_life();
                return;
            }
        }
    }
}

fn main() {
    show_screen(0);
    ppu_on();
    loop {
        wait_vblank();
        let pad = joypad(0);
        let pressed = pad & ~prev;
        prev = pad;
        match state {
            0 | 3 | 4 => { if pressed & BTN_START { new_game(); } }
            1 => {
                update_hero(pad, pressed);
                if state == 1 {
                    camera_follow(hero.x, WORLDS[world]);
                    cam = camera_x();
                    update_foes();
                }
                if hurt > 0 { hurt -= 1; }
            }
            _ => {
                timer -= 1;
                if timer == 0 {
                    world += 1;
                    if world == 6 { show_screen(4); } else {
                        reset_map(WORLDS[world - 1]);   // free its change slots (64 shared)
                        start_world();
                    }
                }
            }
        }
        if state == 1 || state == 2 {
            let hx = hero.x - cam;
            if hurt & 4 { metasprite(1, 0, 0, HERO); } else { metasprite(1, hx as u8, hero.y, HERO); }
            print_u16(7, 1, score);
            print_u8(19, 1, coins);
            set_tile(24, 1, '0' + lives);
        }
    }
}


    "..33..33",
    "..33..33",
];

// Brick tile
tile 6 = [
    "11111111",
    "12222221",
    "12111121",
    "12122121",
    "12121121",
    "12111121",
    "12222221",
    "11111111",
];

// ========== Game Variables ==========

// Player state
var player_x: u8 = 120;
var player_y: u8 = 160;
var player_vel_x: u8 = 0;
var player_vel_y: u8 = 0;
var player_facing: u8 = 0;  // 0 = right, 1 = left

// Input state
var buttons: u8 = 0;
var buttons_pressed: u8 = 0;

// Game state
var game_state: u8 = 0;  // 0 = title, 1 = playing
var frame_counter: u8 = 0;

// Ground level
var ground_y: u8 = 200;

// Temporary variables
var temp_i: u8 = 0;

// ========== Game Logic ==========

fn update_player() {
    // Read input
    buttons = joypad(0);

    // Horizontal movement
    if buttons & BTN_LEFT {
        if player_x > 0 {
            player_x -= 2;
        }
        player_facing = 1;
    }
    if buttons & BTN_RIGHT {
        if player_x < 240 {
            player_x += 2;
        }
        player_facing = 0;
    }

    // Jumping
    if buttons & BTN_A {
        if player_y >= ground_y {
            player_vel_y = 12;  // Jump velocity
        }
    }

    // Apply gravity
    if player_y < ground_y {
        player_vel_y -= 1;
    } else {
        player_y = ground_y;
        player_vel_y = 0;
    }

    // Apply vertical velocity
    if player_vel_y > 0 {
        if player_y > player_vel_y {
            player_y -= player_vel_y;
        } else {
            player_y = 0;
        }
    }
}

fn draw_player() {
    // Draw Mario (2x2 sprites)
    sprite(0, player_x, player_y, 1, 1);
    sprite(1, player_x + 8, player_y, 2, 1);
    sprite(2, player_x, player_y + 8, 3, 1);
    sprite(3, player_x + 8, player_y + 8, 4, 1);
}

fn draw_ground() {
    // Draw ground tiles in VRAM
    ppu_off();
    temp_i = 0;
    loop {
        if temp_i >= 32 { break; }
        vram_addr(0x2340 + temp_i);  // Row 23
        vram_put(5);  // Ground tile
        temp_i += 1;
    }
    ppu_on();
}

fn show_title() {
    ppu_off();

    // Clear screen
    vram_addr(0x2000);
    vram_fill(0, 1024);

    // Draw title
    print(7, 8, "SUPER MARIO BROS");
    print(9, 10, "DEMO VERSION");
    print(8, 14, "PRESS START");
    print(7, 18, "USE D-PAD + A JUMP");

    ppu_on();

    // Wait for start
    loop {
        wait_vblank();
        let pad = joypad(0);
        if pad & BTN_START {
            break;
        }
    }
}

fn init_game() {
    ppu_off();

    // Load palette
    load_palette(PAL);

    // Clear screen
    vram_addr(0x2000);
    vram_fill(0, 1024);

    // Draw ground
    draw_ground();

    ppu_on();

    // Set initial player position
    player_x = 40;
    player_y = ground_y;
    player_vel_y = 0;
}

// ========== Main Entry Point ==========

fn main() {
    // Show title screen
    show_title();

    // Initialize game
    init_game();

    game_state = 1;

    // Main game loop
    loop {
        wait_vblank();

        frame_counter += 1;

        // Update game
        update_player();

        // Draw graphics
        draw_player();
    }
}
